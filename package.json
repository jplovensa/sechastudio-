{
  "name": "secha-studio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "python3 -m http.server 8000 --bind 127.0.0.1",
    "build": "tailwindcss -i css/tailwind-input.css -o css/utilities.css --content 'index.html,js/*.js' --minify",
    "test": "node --test tests/*.test.cjs",
    "test:e2e": "node tests/e2e.cjs",
    "test:studio": "node tests/studio-experience.cjs",
    "test:playground": "node tests/playground.cjs",
    "render:intro": "node scripts/render-intro.cjs",
    "test:floors": "node tests/playground-floors.cjs",
    "test:commercial": "node tests/commercial-styling.cjs"
  },
  "devDependencies": {
    "axe-core": "4.10.3",
    "playwright": "1.58.2",
    "tailwindcss": "3.4.17"
  }
}
